import java.util.Scanner;

public class DiagnosticoConectividad {

    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);
        int opcionMenu;
        String resp1, resp2;
        String continuar = "S";

        while (continuar.equalsIgnoreCase("S")) {
            System.out.println("=======================================================");
            System.out.println("   SISTEMA DE DIAGNOSTICO DE PROBLEMAS DE CONECTIVIDAD ");
            System.out.println("=======================================================");
            System.out.println("Seleccione el sintoma principal que presenta su equipo:");
            System.out.println("1. Sin acceso a Internet (icono de red con alerta o desconectado)");
            System.out.println("2. Conectado a la red Wi-Fi, pero las paginas no cargan");
            System.out.println("3. Conexion muy lenta o intermitente");
            System.out.println("4. Salir del programa");
            System.out.println("-------------------------------------------------------");
            System.out.print("Ingrese una opcion (1-4): ");
            opcionMenu = teclado.nextInt();
            teclado.nextLine(); // Limpia el salto de línea

            switch (opcionMenu) {
                case 1:
                    System.out.println("\n--- DIAGNOSTICO: SIN ACCESO A INTERNET ---");
                    System.out.print("¿El cable de red esta conectado o el Wi-Fi esta encendido? (S/N): ");
                    resp1 = teclado.nextLine();

                    if (resp1.equalsIgnoreCase("N")) {
                        System.out.println("\n>> DIAGNOSTICO: Adaptador de red desactivado o cable desconectado.");
                        System.out.println(">> SOLUCION: Active el interruptor Wi-Fi de su equipo o verifique que el cable Ethernet este bien conectado.");
                    } else {
                        System.out.print("¿Otros dispositivos (celular, tablet) tienen internet en la misma red? (S/N): ");
                        resp2 = teclado.nextLine();

                        if (resp2.equalsIgnoreCase("N")) {
                            System.out.println("\n>> DIAGNOSTICO: Falla general en el router o en el proveedor de Internet (ISP).");
                            System.out.println(">> SOLUCION: Reinicie el router (desconectelo 30 segundos). Si el problema persiste, contacte a su operador.");
                        } else {
                            System.out.println("\n>> DIAGNOSTICO: Falla de configuracion IP o controlador en este equipo.");
                            System.out.println(">> SOLUCION: Desactive y vuelva a activar el Wi-Fi del equipo o ejecute el solucionador de problemas de Windows.");
                        }
                    }
                    break;

                case 2:
                    System.out.println("\n--- DIAGNOSTICO: CONECTADO PERO SIN NAVEGACION ---");
                    System.out.print("¿Aparece un mensaje de error de DNS en el navegador? (S/N): ");
                    resp1 = teclado.nextLine();

                    if (resp1.equalsIgnoreCase("S")) {
                        System.out.println("\n>> DIAGNOSTICO: Falla en la resolucion de nombres de dominio (DNS).");
                        System.out.println(">> SOLUCION: Cambie los servidores DNS de su adaptador a los de Google (8.8.8.8 y 8.8.4.4) o reinicie la cache DNS.");
                    } else {
                        System.out.print("¿El problema ocurre en todos los navegadores (Chrome, Edge, etc.)? (S/N): ");
                        resp2 = teclado.nextLine();

                        if (resp2.equalsIgnoreCase("S")) {
                            System.out.println("\n>> DIAGNOSTICO: Posible bloqueo de Firewall, Antivirus o Proxy mal configurado.");
                            System.out.println(">> SOLUCION: Revise la configuracion de Proxy del sistema y verifique que el antivirus no bloquee la salida a Internet.");
                        } else {
                            System.out.println("\n>> DIAGNOSTICO: Falla especifica del navegador web.");
                            System.out.println(">> SOLUCION: Borre el historial y la cache del navegador afectado o reinstalelo.");
                        }
                    }
                    break;

                case 3:
                    System.out.println("\n--- DIAGNOSTICO: CONEXION LENTA O INTERMITENTE ---");
                    System.out.print("¿Se encuentra lejos del router o hay varias paredes de por medio? (S/N): ");
                    resp1 = teclado.nextLine();

                    if (resp1.equalsIgnoreCase("S")) {
                        System.out.println("\n>> DIAGNOSTICO: Atenuacion y baja intensidad de señal Wi-Fi.");
                        System.out.println(">> SOLUCION: Acerquese al punto de acceso, conectese a la banda 2.4 GHz (mayor alcance) o use un repetidor.");
                    } else {
                        System.out.print("¿Hay muchos dispositivos conectados descargando archivos o viendo video? (S/N): ");
                        resp2 = teclado.nextLine();

                        if (resp2.equalsIgnoreCase("S")) {
                            System.out.println("\n>> DIAGNOSTICO: Saturacion del ancho de banda.");
                            System.out.println(">> SOLUCION: Pause descargas pesadas en segundo plano y desconecte dispositivos que no esten en uso.");
                        } else {
                            System.out.println("\n>> DIAGNOSTICO: Interferencia de canal Wi-Fi o saturacion del router.");
                            System.out.println(">> SOLUCION: Reinicie el router para liberar memoria y reasignar un canal menos congestionado.");
                        }
                    }
                    break;

                case 4:
                    System.out.println("\nSaliendo del sistema de diagnostico. ¡Hasta pronto!");
                    continuar = "N";
                    break;

                default:
                    System.out.println("\nERROR: Opcion no valida. Por favor seleccione un numero del 1 al 4.");
                    break;
            }

            if (opcionMenu != 4) {
                System.out.println("\n-------------------------------------------------------");
                System.out.print("¿Desea realizar otro diagnostico? (S/N): ");
                continuar = teclado.nextLine();
                System.out.println();
            }
        }

        teclado.close();
    }
}
