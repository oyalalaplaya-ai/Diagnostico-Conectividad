import javax.swing.*;
import java.awt.*;

public class DiagnosticoConectividad extends JFrame {

    private JTextArea areaResultado;

    public DiagnosticoConectividad() {
        // Configuración de la ventana principal
        setTitle("Sistema de Diagnóstico de Conectividad");
        setSize(620, 460);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null); // Centra la ventana en pantalla
        setLayout(new BorderLayout(10, 10));

        // Panel Superior: Título e instrucciones
        JPanel panelSuperior = new JPanel(new GridLayout(2, 1));
        panelSuperior.setBorder(BorderFactory.createEmptyBorder(15, 15, 5, 15));
        
        JLabel lblTitulo = new JLabel("DIAGNÓSTICO DE PROBLEMAS DE CONECTIVIDAD", SwingConstants.CENTER);
        lblTitulo.setFont(new Font("Segoe UI", Font.BOLD, 16));
        lblTitulo.setForeground(new Color(0, 70, 140));
        
        JLabel lblSubtitulo = new JLabel("Seleccione el síntoma principal que presenta su equipo:", SwingConstants.CENTER);
        lblSubtitulo.setFont(new Font("Segoe UI", Font.PLAIN, 13));
        
        panelSuperior.add(lblTitulo);
        panelSuperior.add(lblSubtitulo);
        add(panelSuperior, BorderLayout.NORTH);

        // Panel Central: Botones de síntomas
        JPanel panelBotones = new JPanel(new GridLayout(4, 1, 10, 10));
        panelBotones.setBorder(BorderFactory.createEmptyBorder(5, 30, 10, 30));

        JButton btnOpcion1 = new JButton("1. Sin acceso a Internet (icono con alerta o desconectado)");
        JButton btnOpcion2 = new JButton("2. Conectado al Wi-Fi, pero las páginas no cargan");
        JButton btnOpcion3 = new JButton("3. Conexión muy lenta o intermitente");
        JButton btnLimpiar = new JButton("Limpiar resultado");

        Font fuenteBtn = new Font("Segoe UI", Font.BOLD, 12);
        btnOpcion1.setFont(fuenteBtn);
        btnOpcion2.setFont(fuenteBtn);
        btnOpcion3.setFont(fuenteBtn);

        panelBotones.add(btnOpcion1);
        panelBotones.add(btnOpcion2);
        panelBotones.add(btnOpcion3);
        panelBotones.add(btnLimpiar);
        add(panelBotones, BorderLayout.CENTER);

        // Panel Inferior: Área de diagnóstico y solución
        areaResultado = new JTextArea(7, 40);
        areaResultado.setEditable(false);
        areaResultado.setLineWrap(true);
        areaResultado.setWrapStyleWord(true);
        areaResultado.setFont(new Font("Segoe UI", Font.PLAIN, 13));
        areaResultado.setBorder(BorderFactory.createTitledBorder("Resultado del Diagnóstico y Solución"));
        
        JScrollPane scroll = new JScrollPane(areaResultado);
        scroll.setBorder(BorderFactory.createEmptyBorder(0, 15, 15, 15));
        add(scroll, BorderLayout.SOUTH);

        // --- EVENTOS DE LOS BOTONES (Equivalente al bloque SEGÚN de PSeInt) ---

        // Caso 1: Sin acceso a Internet
        btnOpcion1.addActionListener(e -> {
            int r1 = preguntar("¿El cable de red está conectado o el Wi-Fi está encendido?");
            if (r1 == JOptionPane.NO_OPTION) {
                mostrarDiagnostico(
                    "Adaptador de red desactivado o cable desconectado.",
                    "Active el interruptor Wi-Fi de su equipo o verifique que el cable Ethernet esté bien conectado."
                );
            } else if (r1 == JOptionPane.YES_OPTION) {
                int r2 = preguntar("¿Otros dispositivos (celular, tablet) tienen internet en la misma red?");
                if (r2 == JOptionPane.NO_OPTION) {
                    mostrarDiagnostico(
                        "Falla general en el router o en el proveedor de Internet (ISP).",
                        "Reinicie el router (desconéctelo 30 segundos). Si el problema persiste, contacte a su operador."
                    );
                } else if (r2 == JOptionPane.YES_OPTION) {
                    mostrarDiagnostico(
                        "Falla de configuración IP o controlador en este equipo.",
                        "Desactive y vuelva a activar el Wi-Fi del equipo o ejecute el solucionador de problemas de Windows."
                    );
                }
            }
        });

        // Caso 2: Conectado pero sin navegación
        btnOpcion2.addActionListener(e -> {
            int r1 = preguntar("¿Aparece un mensaje de error de DNS en el navegador?");
            if (r1 == JOptionPane.YES_OPTION) {
                mostrarDiagnostico(
                    "Falla en la resolución de nombres de dominio (DNS).",
                    "Cambie los servidores DNS de su adaptador a los de Google (8.8.8.8 y 8.8.4.4) o reinicie la caché DNS."
                );
            } else if (r1 == JOptionPane.NO_OPTION) {
                int r2 = preguntar("¿El problema ocurre en todos los navegadores (Chrome, Edge, etc.)?");
                if (r2 == JOptionPane.YES_OPTION) {
                    mostrarDiagnostico(
                        "Posible bloqueo de Firewall, Antivirus o Proxy mal configurado.",
                        "Revise la configuración de Proxy del sistema y verifique que el antivirus no bloquee la salida a Internet."
                    );
                } else if (r2 == JOptionPane.NO_OPTION) {
                    mostrarDiagnostico(
                        "Falla específica del navegador web.",
                        "Borre el historial y la caché del navegador afectado o reinstálelo."
                    );
                }
            }
        });

        // Caso 3: Conexión lenta o intermitente
        btnOpcion3.addActionListener(e -> {
            int r1 = preguntar("¿Se encuentra lejos del router o hay varias paredes de por medio?");
            if (r1 == JOptionPane.YES_OPTION) {
                mostrarDiagnostico(
                    "Atenuación y baja intensidad de señal Wi-Fi.",
                    "Acérquese al punto de acceso, conéctese a la banda 2.4 GHz (mayor alcance) o use un repetidor."
                );
            } else if (r1 == JOptionPane.NO_OPTION) {
                int r2 = preguntar("¿Hay muchos dispositivos conectados descargando archivos o viendo video?");
                if (r2 == JOptionPane.YES_OPTION) {
                    mostrarDiagnostico(
                        "Saturación del ancho de banda.",
                        "Pause descargas pesadas en segundo plano y desconecte dispositivos que no estén en uso."
                    );
                } else if (r2 == JOptionPane.NO_OPTION) {
                    mostrarDiagnostico(
                        "Interferencia de canal Wi-Fi o saturación del router.",
                        "Reinicie el router para liberar memoria y reasignar un canal menos congestionado."
                    );
                }
            }
        });

        // Botón Limpiar
        btnLimpiar.addActionListener(e -> areaResultado.setText(""));
    }

    // Método auxiliar para hacer preguntas Sí/No
    private int preguntar(String mensaje) {
        return JOptionPane.showConfirmDialog(
            this, mensaje, "Pregunta de Diagnóstico", JOptionPane.YES_NO_OPTION
        );
    }

    // Método auxiliar para formatear la salida en pantalla
    private void mostrarDiagnostico(String diagnostico, String solucion) {
        areaResultado.setText(
            ">> DIAGNÓSTICO:\n" + diagnostico + "\n\n" +
            ">> SOLUCIÓN RECOMENDADA:\n" + solucion
        );
    }

    // Método principal (Main)
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new DiagnosticoConectividad().setVisible(true);
        });
    }
}
